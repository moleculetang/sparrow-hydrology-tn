{
  "scenario_id": "20260816_4",
  "purpose": "run all 63 fixed legacy candidates with fold-specific nuisance efficiencies and independent groundwater-N context",
  "candidate_count": 63,
  "river_tn_selection_years": [2018, 2019, 2020, 2021],
  "locked_year_excluded": 2022,
  "eta_contract": {
    "parameters": ["eta_quick", "eta_gw"],
    "scope": "basin-wide and re-estimated separately for every candidate and OOF fold",
    "bounds": [0.0, 1.0],
    "prior_center": 1.0,
    "ridge_lambda": 1.0,
    "station_log_effect_ridge_lambda": 12.0,
    "solver": "scipy.optimize.least_squares(method=trf)",
    "external_evidence_forbidden": true,
    "boundary_tolerance": 0.01
  },
  "groundwater_pattern_operator": "sum(gw_path_tn_release)/sum(gw_discharge_volume), eta_gw excluded",
  "groundwater_independent_unit": "aquifer_id_x_decade",
  "groundwater_trend_rule": "only matched decades within the same aquifer_id",
  "groundwater_role": "contextual_not_hard_gate",
  "mass_gate": {
    "minimum_state_or_flux_kg_n": -1e-9,
    "maximum_relative_mass_balance_error": 1e-12
  }
}
