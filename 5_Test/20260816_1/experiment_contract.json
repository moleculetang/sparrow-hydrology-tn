  },
  "glhymps_contract": {
    "permeability_field": "logK_Ferr_",
    "porosity_field": "Porosity_x",
    "layer": "near_surface_without_permafrost",
    "native_permeability_encoding": "log10(permeability_m2)*100",
    "permeability_transform": "k_m2=10**(logK_Ferr_/100)",
    "porosity_transform": "n=Porosity_x/100",
    "deep_layer_available": false,
    "path_operator": "sum(delta_L*n/(K*i))",
    "reach_weighting": "effective-area uniform-recharge approximation",
    "hard_contradiction_requires": "agreement of local-gradient and path-gradient methods"
  },
  "groundwater_n_contract": {
    "independent_unit": "aquifer_id_x_decade",
    "trend_requires": "matched decades within the same aquifer_id",
