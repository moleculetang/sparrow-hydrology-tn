    "kernel_hydrogeo_comparison": "ungated",
    "realized_mass_water_diagnostic": "water_gated"
  },
  "nuisance_efficiency_contract": {
    "parameters": ["eta_quick", "eta_gw"],
    "scope": "two basin-wide parameters re-estimated independently in every candidate and OOF fold",
    "training_data": "river TN training period only",
    "bounds": [0.0, 1.0],
    "eta_prior_center": 1.0,
    "eta_ridge_lambda": 1.0,
    "station_log_effect_ridge_lambda": 12.0,
    "solver": "scipy.optimize.least_squares(method=trf)",
    "boundary_tolerance": 0.01,
    "reach_station_tree_specific_eta_forbidden": true,
    "external_evidence_for_eta_forbidden": true
  },
  "soil_operator_contract": {
    "formal_pattern": "cropland TN enrichment, not whole-reach total TN",
    "crop_dominant_fraction_min": 0.70,
    "noncrop_dominant_fraction_max": 0.30,
    "minimum_each_class_fraction": 0.10,
