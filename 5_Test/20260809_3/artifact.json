  "sources": [
    {
      "id": "src_risk",
      "label": "230条Reach全量风险注册表",
      "path": "reports/full_reach_risk_registry.csv",
      "query": {
        "engine": "DuckDB",
        "sql": "SELECT * FROM read_csv_auto('reports/full_reach_risk_registry.csv', header=true);",
        "description": "全网图结构、几何、DEM、Catchment和模型代表站风险注册表。",
        "language": "sql",
        "tables_used": [
          "reports/full_reach_risk_registry.csv"
        ],
        "filters": [
          "Frozen PRB topology snapshot",
          "No mainline files modified"
        ],
        "metric_definitions": [
          "风险数按230条唯一reach_id计数。"
        ]
      }
    },
    {
      "id": "src_external",
      "label": "坐标外部河网交叉验证",
      "path": "reports/coordinate_based_external_geography_evidence.csv",
      "query": {
        "engine": "DuckDB",
        "sql": "SELECT * FROM read_csv_auto('reports/coordinate_based_external_geography_evidence.csv', header=true);",
        "description": "按固定经纬度或本地Reach包围盒从OpenStreetMap提取水系并计算空间距离；名称不参与候选定位。",
        "language": "sql",
        "tables_used": [
          "reports/coordinate_based_external_geography_evidence.csv",
          "reports/external_raw/*.json"
        ],
        "filters": [
          "Frozen PRB topology snapshot",
          "No mainline files modified"
        ],
        "metric_definitions": [
          "外部河网距离在本地等积投影中计算；名称仅辅助。"
        ]
      }
    },
    {
      "id": "src_counterfactual",
      "label": "候选补边反事实影响",
      "path": "reports/candidate_edge_counterfactual_summary.csv",
      "query": {
        "engine": "DuckDB",
        "sql": "SELECT * FROM read_csv_auto('reports/candidate_edge_counterfactual_summary.csv', header=true);",
        "description": "在冻结DAG副本中加入5条候选边，重新递推累计面积并追踪下游Reach与Q72代表站。",
        "language": "sql",
        "tables_used": [
          "reports/candidate_edge_counterfactual_summary.csv",
          "reports/candidate_edge_downstream_impact.csv"
        ],
        "filters": [
          "Frozen PRB topology snapshot",
          "No mainline files modified"
        ],
        "metric_definitions": [
          "受影响Reach为接收Reach及其全部下游；模型未重跑。"
        ]
      }
    },
    {
      "id": "src_station",
      "label": "站点坐标与同Reach代表站审计",
      "path": "reports/all_station_coordinate_based_spatial_classification.csv",
      "query": {
        "engine": "DuckDB",
        "sql": "SELECT * FROM read_csv_auto('reports/all_station_coordinate_based_spatial_classification.csv', header=true);",
        "description": "按坐标、最近Reach及增量Catchment包含关系分类，并验证同Reach选择最大median_q_cfs。",
        "language": "sql",
        "tables_used": [
          "reports/all_station_coordinate_based_spatial_classification.csv",
          "reports/same_reach_representative_selection_validation.csv"
        ],
        "filters": [
          "Frozen PRB topology snapshot",
          "No mainline files modified"
        ],
        "metric_definitions": [
          "Q72代表站按唯一station_key—assigned_reach_id去重。"
        ]
      }
    },
    {
      "id": "src_lowflow",
      "label": "28个低流目标与背景Reach风险比较",
      "path": "reports/legacy_lowflow_vs_other_topology_risk.csv",
      "query": {
        "engine": "DuckDB",
        "sql": "SELECT * FROM read_csv_auto('reports/legacy_lowflow_vs_other_topology_risk.csv', header=true);",
        "description": "比较28个冻结低流目标与其余202条Reach的拓扑风险率。",
        "language": "sql",
        "tables_used": [
          "reports/legacy_lowflow_vs_other_topology_risk.csv"
        ],
        "filters": [
          "Frozen PRB topology snapshot",
          "No mainline files modified"
        ],
        "metric_definitions": [
          "分母分别为28和202条唯一Reach。"
        ]
      }
    }
  ]
